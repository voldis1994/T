# Capital.com API — vai aizpildi šeit, vai reģistrējies dashboardā (http://127.0.0.1:8080)
# Capital.com → Settings → API Integrations → Generate new key
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_ENV=demo
# demo → https://demo-api-capital.backend-capital.com
# live → https://api-capital.backend-capital.com

# Primary instrument (epic)
SHADOW_EPIC=EURUSD
SHADOW_SIZE=1000

# Server
SHADOW_HOST=0.0.0.0
SHADOW_PORT=8080